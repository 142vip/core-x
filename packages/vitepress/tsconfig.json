{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "typedoc": [
        "./node_modules/typedoc/dist/types/index.d.ts"
      ],
      "vitepress/types/default-theme": [
        "./node_modules/vitepress/types/default-theme.d.ts"
      ],
      "vitepress/types/shared": [
        "./node_modules/vitepress/types/shared.d.ts"
      ],
      "vitepress/dist/client": [
        "./node_modules/vitepress/dist/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
